# Firebase Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# Option A (recommended for Render/Vercel): paste the entire service-account
# JSON as a single-line string here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B (local/dev): point to a service-account file instead, and leave
# FIREBASE_SERVICE_ACCOUNT_JSON unset.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

PORT=3000
